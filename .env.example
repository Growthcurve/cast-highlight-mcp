# CAST Highlight API Configuration
# Copy this file to .env and fill in your credentials

# Required: CAST Highlight API base URL
HIGHLIGHT_BASE_URL=https://app.casthighlight.com/WS2

# Required: Access token from Token Management
# Generate at: https://app.casthighlight.com/#Administration/Token
HIGHLIGHT_ACCESS_TOKEN=your-access-token

# Required: Your company ID (visible in URL when viewing company)
HIGHLIGHT_COMPANY_ID=your-company-id

# Optional: API timeout in seconds (default: 30)
HIGHLIGHT_TIMEOUT=30

# Optional: Retry configuration for transient failures
# Number of retry attempts (default: 3)
# HIGHLIGHT_RETRY_ATTEMPTS=3

# Minimum wait between retries in seconds (default: 1.0)
# HIGHLIGHT_RETRY_MIN_WAIT=1.0

# Maximum wait between retries in seconds (default: 10.0)
# HIGHLIGHT_RETRY_MAX_WAIT=10.0

# Exponential backoff multiplier (default: 2.0)
# HIGHLIGHT_RETRY_MULTIPLIER=2.0
